{
  "name": "desktop-cat",
  "version": "0.2.0",
  "description": "Your little 3D desktop companion",
  "main": "src/electron/main.cjs",
  "author": "Desktop Cat",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build:native && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:browser": "playwright test",
    "build:native": "node scripts/build-native.cjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "studio.desktopcat.companion",
    "productName": "Desktop Cat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "src/shared/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "artifactName": "Desktop-Cat-${version}-Setup-${arch}.${ext}",
      "include": "scripts/installer.nsh",
      "allowElevation": false
    },
    "extraResources": [
      {
        "from": "native/bin/desktop-cat-input.exe",
        "to": "native/desktop-cat-input.exe"
      }
    ],
    "portable": {
      "artifactName": "Desktop-Cat-${version}-Portable-${arch}.${ext}"
    }
  }
}
